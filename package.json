{
  "name": "happy-blocks",
  "version": "1.0.0",
  "private": true,
  "description": "Happy Blocks — the web game plus its iOS and Android apps (Capacitor).",
  "scripts": {
    "build:web": "node tools/build-web.js",
    "sync": "npm run build:web && npx cap sync",
    "icons": "npx @capacitor/assets generate --iconBackgroundColor '#2a1f73' --iconBackgroundColorDark '#2a1f73' --splashBackgroundColor '#1b2458' --splashBackgroundColorDark '#1b2458'",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.25"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "firebase": "^10.14.1"
  }
}
