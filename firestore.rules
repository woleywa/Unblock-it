rules_version = '2';
// Unblock It — paste into Firebase console → Firestore Database → Rules, then Publish.
// Everyone can read the leaderboards; each device (anonymous account) can only write its own data.
// Team totals are kept honest from both sides: a player's stars can only change together with their
// team's total, and a team's total/member count can only change by exactly that player's change.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Names may use any letters, numbers, emoji and punctuation (the app keeps them to 2–16/20
    // characters); no slashes (the nickname is a document id), control characters or blank names.
    function okText(n, max) { return n is string && n.size() >= 1 && n.size() <= max && n.matches('^[^/\\x00-\\x1f\\x7f]+$') && !n.matches('^\\s*$'); }
    function validName(n) { return okText(n, 64); }
    function validTeamName(n) { return okText(n, 80); }
    function ownsName(n) {
      return getAfter(/databases/$(database)/documents/names/$(n.lower())).data.uid == request.auth.uid;
    }
    function teamOf(d) { return d.get('team', null); }
    function playerBefore(u) { return get(/databases/$(database)/documents/players/$(u)).data; }
    function playerAfter(u) { return getAfter(/databases/$(database)/documents/players/$(u)).data; }
    function teamBefore(t) { return get(/databases/$(database)/documents/teams/$(t)).data; }
    function teamAfter(t) { return getAfter(/databases/$(database)/documents/teams/$(t)).data; }
    function teamStarsBefore(t) {
      return exists(/databases/$(database)/documents/teams/$(t)) ? teamBefore(t).stars : 0;
    }
    function challenge(c) { return get(/databases/$(database)/documents/challenges/$(c)).data; }

    // Settings only the owner changes (with the admin key), e.g. config/hints { uids: [...] } —
    // the registered players who get the hint button.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // One owner per nickname (the document id is the nickname in lower case).
    match /names/{key} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'created'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name)
        && key == request.resource.data.name.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Private: a player's progress (so it follows their account) and friend list.
    match /saves/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['stars', 'moves', 'friends', 'updated', 'meta'])
        && (!('meta' in request.resource.data) || (request.resource.data.meta is map && request.resource.data.meta.size() <= 20))
        && (!('stars' in request.resource.data) || (request.resource.data.stars is map && request.resource.data.stars.size() <= 1000))
        && (!('moves' in request.resource.data) || (request.resource.data.moves is map && request.resource.data.moves.size() <= 1000))
        && (!('friends' in request.resource.data) || (request.resource.data.friends is list && request.resource.data.friends.size() <= 200));
      allow delete: if signedIn() && me() == uid;
    }

    // A player's totals; score = stars × 100000 − moves so the board sorts on one field.
    // `team` (optional) is the code of the team they're in.
    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'stars', 'moves', 'levels', 'score', 'best', 'updated', 'team', 'helped'])
        && (!('helped' in d) || (d.helped is int && d.helped >= 0 && d.helped <= 100000))
        && validName(d.name) && ownsName(d.name)
        && d.stars is int && d.stars >= 0 && d.stars <= 3000
        && d.moves is int && d.moves >= 0 && d.moves < 100000
        && d.levels is int && d.levels >= 0 && d.levels <= 1000
        && d.score == d.stars * 100000 - d.moves
        && (teamOf(d) == null || teamOf(d) is string);
    }
    function teamSynced() {
      let n = request.resource.data;
      let oStars = resource == null ? 0 : resource.data.stars;
      let ot = resource == null ? null : teamOf(resource.data);
      let nt = teamOf(n);
      return ot == nt
        ? (nt == null || n.stars == oStars || teamAfter(nt).stars == teamBefore(nt).stars + (n.stars - oStars))
        : (ot == null || teamAfter(ot).stars == teamBefore(ot).stars - oStars)
          && (nt == null || teamAfter(nt).stars == teamStarsBefore(nt) + n.stars);
    }
    match /players/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && me() == uid && validPlayer(request.resource.data) && teamSynced();
      // Deleting your account: only once you've left your team (so team totals stay right).
      allow delete: if signedIn() && me() == uid && teamOf(resource.data) == null;
    }

    // Each player's best run per level.
    match /levels/{level}/runs/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'moves', 'updated'])
        && request.resource.data.moves is int && request.resource.data.moves >= 1 && request.resource.data.moves <= 999
        && get(/databases/$(database)/documents/players/$(uid)).data.name == request.resource.data.name;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Help requests: "can you solve this level for me?" Listed only by the asker and the friends it
    // was sent to; anyone who has the (random, 12-character) id from a shared link can open and answer it.
    // Little gifts between friends: one per sender, friend and day (the id says so, and a sent gift
    // can't be changed), seen by the friend and then cleared.
    match /gifts/{id} {
      allow get, list: if signedIn() && (resource.data.to == me() || resource.data.from == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'kind', 'day', 'created', 'seen'])
        && request.resource.data.from == me()
        && request.resource.data.fromName == playerBefore(me()).name
        && request.resource.data.to is string && request.resource.data.to != me()
        && request.resource.data.kind in ['clap', 'love', 'fire', 'haha', 'brain', 'biscuit', 'freeze']
        && request.resource.data.day is int && request.resource.data.day >= 1 && request.resource.data.day < 100000
        && id == me() + '_' + request.resource.data.to + '_' + string(request.resource.data.day)
        && request.resource.data.seen == false
        && request.resource.data.created == request.time;
      allow update: if signedIn() && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']) && request.resource.data.seen == true;
      allow delete: if signedIn() && (resource.data.to == me() || resource.data.from == me());
    }

    match /help/{id} {
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.from == me() || me() in resource.data.to);
      allow create: if signedIn() && id.matches('^[A-Z0-9]{12}$')
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'level', 'par', 'to', 'created'])
        && request.resource.data.from == me()
        && request.resource.data.fromName == playerBefore(me()).name
        && request.resource.data.level is int && request.resource.data.level >= 0 && request.resource.data.level < 1000
        && request.resource.data.par is int && request.resource.data.par >= 1 && request.resource.data.par < 1000
        && request.resource.data.to is list && request.resource.data.to.size() <= 20
        && request.resource.data.created == request.time;
      allow delete: if signedIn() && resource.data.from == me();

      // A friend's solution: every drag as { p: block, r, c, g: door (0 = just a move) }.
      match /answers/{uid} {
        allow read: if signedIn() && (me() == uid || get(/databases/$(database)/documents/help/$(id)).data.from == me());
        allow create, update: if signedIn() && me() == uid
          && exists(/databases/$(database)/documents/help/$(id))
          && get(/databases/$(database)/documents/help/$(id)).data.from != me()
          && request.resource.data.keys().hasOnly(['name', 'moves', 'steps', 'created'])
          && request.resource.data.name == playerBefore(uid).name
          && request.resource.data.steps is list && request.resource.data.steps.size() >= 1 && request.resource.data.steps.size() <= 999
          && request.resource.data.moves == request.resource.data.steps.size()
          && request.resource.data.created == request.time;
        allow delete: if false;
      }
    }

    // Teams: the document id is the invite code. members ≤ 20; stars = the members' stars added up.
    function memberChange(t) {
      let a = playerAfter(me());
      let b = playerBefore(me());
      let n = request.resource.data;
      let o = resource.data;
      return (teamOf(b) == t && teamOf(a) == t && n.members == o.members && n.stars == o.stars + (a.stars - b.stars))
        || (teamOf(b) != t && teamOf(a) == t && n.members == o.members + 1 && n.stars == o.stars + a.stars)
        || (teamOf(b) == t && teamOf(a) != t && n.members == o.members - 1 && n.stars == o.stars - b.stars);
    }
    match /teams/{t} {
      allow read: if true;
      allow create: if signedIn()
        && t.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'by', 'members', 'stars', 'created'])
        && validTeamName(request.resource.data.name)
        && request.resource.data.by == me()
        && request.resource.data.members == 1
        && request.resource.data.created == request.time
        && teamOf(playerAfter(me())) == t
        && request.resource.data.stars == playerAfter(me()).stars;
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'stars'])
          && request.resource.data.members <= 20
          && memberChange(t))
        // Any member can rename the team.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validTeamName(request.resource.data.name)
          && teamOf(playerBefore(me())) == t));
      allow delete: if false;
    }

    // Challenges: the document id is the invite code. `start` + `window` minutes is when it's open;
    // `playMin` (0 = no limit) is each player's own clock from when they start; `levels` 0 = no limit;
    // `players` = how many can join; `joined` counts them.
    function validChallenge(d) {
      let p = playerBefore(me());
      return d.keys().hasOnly(['by', 'byName', 'team', 'teamName', 'created', 'start', 'window', 'playMin', 'levels', 'players', 'joined', 'seed'])
        && d.by == me() && d.byName == p.name
        && d.team == teamOf(p)
        && (d.team == null ? d.teamName == null : d.teamName == teamBefore(d.team).name)
        && d.created == request.time
        && d.start is timestamp && d.start >= request.time && d.start <= request.time + duration.value(7, 'd')
        && d.window is int && d.window >= 5 && d.window <= 10080
        && d.playMin is int && d.playMin >= 0 && d.playMin <= d.window
        && d.levels is int && d.levels >= 0 && d.levels <= 100
        && d.players is int && d.players >= 1 && d.players <= 20
        && d.joined == 0 && d.seed is int;
    }
    function isOpen(x, graceSec) {
      return request.time >= x.start && request.time < x.start + duration.value(x.window * 60 + graceSec, 's');
    }
    match /challenges/{c} {
      allow read: if true;
      allow create: if signedIn() && c.matches('^[A-Z0-9]{6}$') && validChallenge(request.resource.data);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
        && request.resource.data.joined == resource.data.joined + 1
        && request.resource.data.joined <= resource.data.players
        && !exists(/databases/$(database)/documents/challenges/$(c)/entries/$(me()))
        && existsAfter(/databases/$(database)/documents/challenges/$(c)/entries/$(me()));
      allow delete: if false;

      // Each player's result: best moves per level position in `runs`, and totals.
      match /entries/{uid} {
        allow read: if true;
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['name', 'team', 'teamName', 'started', 'updated', 'stars', 'moves', 'solved', 'score', 'runs'])
          && request.resource.data.name == playerBefore(uid).name
          && request.resource.data.team == teamOf(playerBefore(uid))
          && (request.resource.data.team == null ? request.resource.data.teamName == null
              : request.resource.data.teamName == teamBefore(request.resource.data.team).name)
          && request.resource.data.started == request.time && request.resource.data.updated == request.time
          && request.resource.data.stars == 0 && request.resource.data.moves == 0
          && request.resource.data.solved == 0 && request.resource.data.score == 0
          && request.resource.data.runs == {}
          && isOpen(challenge(c), 0)
          && getAfter(/databases/$(database)/documents/challenges/$(c)).data.joined == challenge(c).joined + 1;
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updated', 'stars', 'moves', 'solved', 'score', 'runs'])
          && request.resource.data.updated == request.time
          && isOpen(challenge(c), 30)
          && (challenge(c).playMin == 0 || request.time < resource.data.started + duration.value(challenge(c).playMin * 60 + 30, 's'))
          && request.resource.data.solved is int && request.resource.data.solved >= 0 && request.resource.data.solved <= 100
          && (challenge(c).levels == 0 || request.resource.data.solved <= challenge(c).levels)
          && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= request.resource.data.solved * 3
          && request.resource.data.moves is int && request.resource.data.moves >= 0 && request.resource.data.moves < 100000
          && request.resource.data.score == request.resource.data.stars * 100000 - request.resource.data.moves
          && request.resource.data.runs is map && request.resource.data.runs.size() == request.resource.data.solved;
        allow delete: if false;
      }

      // Challenge invitations: sent by one player to another
      match /invitations/{uid} {
        allow read: if signedIn() && (me() == uid || resource.data.from == me());
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'sent', 'seen'])
          && request.resource.data.from == me()
          && request.resource.data.fromName == playerBefore(me()).name
          && request.resource.data.to == uid
          && request.resource.data.to != me()
          && request.resource.data.sent == request.time
          && request.resource.data.seen == false;
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
          && request.resource.data.seen == true;
        allow delete: if signedIn() && (me() == uid || resource.data.from == me());
      }
    }
  }
}
