{
  "hosting": {
    "public": "www",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/@(index|privacy).html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/@(sw.js|version.json|manifest.webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
